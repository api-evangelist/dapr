                "description": "The metadata attribute key to set."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets a custom metadata attribute on the Dapr sidecar."
        }
      ]
    }
  ],
  "bundled": true

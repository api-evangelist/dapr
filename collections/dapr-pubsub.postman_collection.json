          "name": "Dapr Publish Event",
          "request": {
            "name": "Dapr Publish Event",
            "description": {
              "content": "Publishes an event to the specified topic on the given pub/sub component. If content type is not application/cloudevents+json, the payload is automatically wrapped in a CloudEvent envelope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1.0",
                "publish",
                ":pubsubname",
                ":topic"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metadata.rawPayload",
                  "value": "<string>",
                  "description": "Set to true to disable CloudEvent wrapping of the payload."
                },
                {
                  "disabled": false,
                  "key": "metadata.ttlInSeconds",
                  "value": "<string>",
                  "description": "Time-to-live for the message in seconds."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "pubsubname",
                  "description": "(Required) The name of the pub/sub component."
                },

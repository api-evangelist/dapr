          "name": "Dapr Get Secret",
          "request": {
            "name": "Dapr Get Secret",
            "description": {
              "content": "Retrieves a secret from the specified secret store by name. Supports optional per-request metadata such as version_id and version_stage.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1.0",
                "secrets",
                ":secret-store-name",
                ":name"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "metadata.version_id",
                  "value": "<string>",
                  "description": "Version identifier for the secret (supported by Hashicorp Vault, GCP Secret Manager, AWS Secret Manager)."
                },
                {
                  "disabled": false,
                  "key": "metadata.version_stage",
                  "value": "<string>",
                  "description": "Version stage for the secret (supported by AWS Secret Manager)."
                },
                {
                  "disabled": false,
                  "key": "metadata.namespace",
                  "value": "<string>",
                  "description": "Kubernetes namespace (supported by Kubernetes Secrets)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "secret-store-name",
                  "description": "(Required) The name of the secret store component."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) The name of the secret to retrieve."
                }
